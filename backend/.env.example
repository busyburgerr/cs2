# --- Общее ---
NODE_ENV=development
PORT=4000
# Адрес фронтенда: первый используется в ссылках на оплату, все перечисленные
# через запятую разрешаются в CORS. В режиме разработки любой localhost
# разрешён автоматически.
FRONTEND_URL=http://localhost:3000
CURRENCY=USD

# --- База данных ---
# SQLite для разработки. Для production: postgresql://user:pass@host:5432/db
# (не забудьте поменять provider в prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# --- Авторизация ---
# ОБЯЗАТЕЛЬНО поменять в production (openssl rand -hex 32)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# --- Платежи ---
# mock   — тестовая оплата без денег (только dev)
# stripe — реальный приём платежей, требует `npm i stripe`
PAYMENT_PROVIDER=mock
MIN_DEPOSIT=500
MAX_DEPOSIT=100000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Доля цены предмета при продаже обратно площадке (0.9 = 90%)
SELL_RATE=0.9

# --- Схема БД ---
# Миграции применяются при старте сервера; в dev схема ещё и догоняется под
# schema.prisma автоматически. Демо-данные заливаются, если база пустая.
AUTO_MIGRATE=true
AUTO_SEED=true

# Множитель цен для демо-данных: 1 — долларовый масштаб, ~90 — рублёвый.
# Действует при `npm run db:seed`.
SEED_PRICE_MULTIPLIER=1

# --- Первый администратор (создаётся при сидировании) ---
ADMIN_EMAIL=admin@cs2cases.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
